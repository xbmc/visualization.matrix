msgctxt "Addon Summary"
msgid "Matrix inspired visualization for Kodi."
msgstr "Matrix-inspirerad visualisering för Kodi."

msgctxt "Addon Description"
msgid "This music visualization is inspired by the movie \"Matrix\". It features eight presets."
msgstr "Denna musikvisualisering är inspirerad av filmen ”Matrix”. Den har åtta förinställningar."

msgctxt "#30000"
msgid "General"
msgstr "Allmänt"

msgctxt "#30001"
msgid "Pixel size"
msgstr "Bildpunktsstorlek"

msgctxt "#30002"
msgid "Size of a \"pixel\" which forms the rain."
msgstr "Storlek på en ”pixel” som bildar regnet."

msgctxt "#30003"
msgid "Rain fall speed"
msgstr "Hastighet för regnfall"

msgctxt "#30004"
msgid "The speed how fast the rain is falling."
msgstr "Hastigheten hur snabbt regnet faller."

msgctxt "#30005"
msgid "Noise fluctuation"
msgstr "Bullerfluktuationer"

msgctxt "#30006"
msgid "The speed how fast the noise is changing."
msgstr "Hastigheten hur snabbt ljudet förändras."

msgctxt "#30007"
msgid "Distort threshold"
msgstr "Tröskelvärde för förvrängning"

msgctxt "#30008"
msgid "Threshold of loudness at which vertical distortion occurs."
msgstr "Tröskelvärde för ljudstyrka vid vilken vertikal distorsion uppstår."

msgctxt "#30009"
msgid "User defined pixel size"
msgstr "Användardefinierad bildpunktsstorlek"

msgctxt "#30010"
msgid "Enables the manual setting of the size of the dots."
msgstr "Gör det möjligt att manuellt ställa in storleken på punkterna."

msgctxt "#30011"
msgid "Strength of rain highlights"
msgstr "Styrkan i regnets höjdpunkter"

msgctxt "#30012"
msgid "Sets the colour intensity of individual raindrops at music peaks."
msgstr "Ställer in färgintensiteten för enskilda regndroppar vid musiktoppar."

msgctxt "#30050"
msgid "Red"
msgstr "Röd"

msgctxt "#30051"
msgid "Green"
msgstr "Grön"

msgctxt "#30052"
msgid "Blue"
msgstr "Blå"

msgctxt "#30053"
msgid "The color of the \"pixels\"."
msgstr "Färgen på ”pixlarna”."

msgctxt "#30060"
msgid "Enable performance optimizations"
msgstr "Aktivera prestandaoptimeringar"

msgctxt "#30061"
msgid "Lowers the quality of some shader calculations in order to boost performance (FPS) on slower systems."
msgstr "Sänker kvaliteten på vissa shader-beräkningar för att öka prestandan (bildfrekvensen) på långsammare system."

msgctxt "#30062"
msgid "CRT effect"
msgstr "CRT-effekt"

msgctxt "#30063"
msgid "Adds a CRT-like distortion effect."
msgstr "Lägger till en CRT-liknande distorsionseffekt."

msgctxt "#30100"
msgid "Kodi"
msgstr "Kodi"

msgctxt "#30101"
msgid "Album"
msgstr "Album"

msgctxt "#30102"
msgid "Rain only"
msgstr "Endast regn"

msgctxt "#30103"
msgid "Rain with waveform"
msgstr "Regn med vågform"

msgctxt "#30104"
msgid "Rain with waveform envelope"
msgstr "Regn med vågformshölje"

msgctxt "#30105"
msgid "Clean rain"
msgstr "Rent regn"

msgctxt "#30106"
msgid "Clean rain with waveform"
msgstr "Rent regn med vågform"

msgctxt "#30107"
msgid "Clean rain with waveform envelope"
msgstr "Rent regn med vågformshölje"
